# PDFBay production build configuration
# Canonical production build configuration — committed to the repo. This file
# is loaded automatically by `vite build`; node scripts use SITE_URL from their
# own defaults when the env var is not exported.

# Custom branding (build-time)
VITE_BRAND_NAME=PDFBay
VITE_BRAND_LOGO=images/favicon-no-bg.svg
VITE_FOOTER_TEXT=© 2026 PDFBay. All rights reserved.

# Canonical site URL used by sitemap / i18n page generation / SEO audit
SITE_URL=https://pdfbay.projectbay.uk

# Hide the GitHub star counter (fresh fork, no stars yet)
DISABLE_GITHUB_STARS=true

# Optional: default UI language (build-time). Leave empty for browser detection.
VITE_DEFAULT_LANGUAGE=

# WASM modules — the pre-configured CDN defaults enable advanced PDF features.
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@bentopdf/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@bentopdf/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/

# LibreOffice engine base path. The Cloudflare Worker proxies /lo/* to a GitHub
# Release (assets > 25 MiB cannot be uploaded to Workers static assets), and the
# local copy must be removed from dist/ before deploying (see build:cf).
VITE_LIBREOFFICE_URL=/lo/
